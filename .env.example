# Firebase Admin SDK — paste the ENTIRE downloaded service-account JSON file
# content as one line here (recommended, avoids private-key formatting bugs).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative to the above: three separate fields instead of the full JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Telegram bot (from @BotFather — see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot username without the @ (public info, shown in the admin panel as a clickable link)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Admin panel (make up your own long random values for these two)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Protects the daily cleanup job (Vercel sends this automatically when set)
CRON_SECRET=

# Set to your deployed URL once you have one, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
